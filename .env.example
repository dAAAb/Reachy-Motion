# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- which voice mode starts first: gpt-live | elevenlabs | taigi
REACHY_MOTION_MODE=gpt-live
# auto (robot audio when running on the robot) | robot | local (this computer's mic + speaker)
REACHY_MOTION_AUDIO=auto

# --- OpenAI: GPT-Live-1 voice + the gesture planner (used by every mode)
OPENAI_API_KEY=
# REACHY_MOTION_PLANNER_MODEL=gpt-5.4-nano
# where the robot is (used for weather/news lookups) and its time zone (the robot itself runs on UTC)
# REACHY_MOTION_LOCATION=台灣台北
# REACHY_MOTION_TIMEZONE=Asia/Taipei
# REACHY_MOTION_GPT_LIVE_VOICE=marin
# REACHY_MOTION_GPT_LIVE_BACKEND_MODEL=gpt-5.4-mini

# --- ElevenLabs Agents (Eleven v4 Turbo voice)
ELEVENLABS_AGENT_ID=
# only needed for a private agent (the app then fetches a signed URL)
ELEVENLABS_API_KEY=
# optional per-session overrides — must be enabled in the agent's Security tab first
# REACHY_MOTION_ELEVENLABS_OVERRIDE=true
# ELEVENLABS_VOICE_ID=
# REACHY_MOTION_ELEVENLABS_TTS_MODEL=eleven_v4_turbo

# --- Taiwanese local pipeline (see wiki/voices/Taigi Local Pipeline.md)
# REACHY_MOTION_TAIGI_ASR_URL=http://127.0.0.1:18001/v1/audio/transcriptions
# REACHY_MOTION_TAIGI_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
# REACHY_MOTION_TAIGI_TTS_URL=http://127.0.0.1:8883/v1/audio/speech
